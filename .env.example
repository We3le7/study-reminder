# ===== 方式一：应用私聊（推荐）=====
# 在 open.feishu.cn → 你的应用 → 凭证与基础信息 中获取
export FEISHU_APP_ID='cli_xxxxxxxxxxxxxxxx'
export FEISHU_APP_SECRET='your-app-secret'

# 接收方：优先用 union_id（跨应用稳定，不随应用变化）
# 获取方式见 README「如何拿到 union_id」
export FEISHU_RECEIVE_ID='on_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
export FEISHU_RECEIVE_ID_TYPE='union_id'

# ===== 方式二：群机器人 Webhook（备选，二选一）=====
# export FEISHU_WEBHOOK='https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx'
# export FEISHU_SECRET='xxxxxxxx'

# 用法：
#   cp .env.example .env   # 填入真实值，.env 已被 .gitignore 忽略
#   source .env
#   python3 remind.py --dry-run
#   python3 remind.py
